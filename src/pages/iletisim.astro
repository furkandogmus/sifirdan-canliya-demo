---
import Base from "../layouts/Base.astro";
import { FORM_SITE_URL } from "../consts";
---

<Base title="İletişim" description="Soru, öneri ya da eklemek istediğin bir bölüm mü var? Yaz.">
  <section class="mx-auto max-w-2xl px-4 py-16 sm:px-6">
    <p class="font-mono text-sm uppercase tracking-[0.2em] text-accent">İletişim</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">Bize yaz</h1>
    <p class="mt-4 text-lg text-muted">
      Soru, öneri ya da eklemek istediğin bir bölüm mü var? Bu form sunucusuz çalışır: gönderimleri Netlify Forms
      toplar, ücretsizdir.
    </p>

    <form
      name="iletisim"
      method="POST"
      action="/tesekkurler.html"
      data-netlify="true"
      netlify-honeypot="adres"
      class="mt-10 grid gap-5"
    >
      <input type="hidden" name="form-name" value="iletisim" />
      <p class="hidden">
        <label>Bunu doldurma: <input name="adres" tabindex="-1" autocomplete="off" /></label>
      </p>

      <label class="grid gap-2">
        <span class="text-sm font-semibold">Adın</span>
        <input
          name="isim"
          required
          maxlength="60"
          class="rounded-xl border border-line bg-panel px-4 py-3 text-paper outline-none focus:border-accent"
        />
      </label>

      <label class="grid gap-2">
        <span class="text-sm font-semibold">E-posta <span class="font-normal text-dim">(cevap için, isteğe bağlı)</span></span>
        <input
          name="eposta"
          type="email"
          maxlength="120"
          class="rounded-xl border border-line bg-panel px-4 py-3 text-paper outline-none focus:border-accent"
        />
      </label>

      <label class="grid gap-2">
        <span class="text-sm font-semibold">Mesajın</span>
        <textarea
          name="mesaj"
          required
          rows="6"
          maxlength="2000"
          class="rounded-xl border border-line bg-panel px-4 py-3 text-paper outline-none focus:border-accent"
        ></textarea>
      </label>

      <button type="submit" class="justify-self-start rounded-xl bg-accent px-6 py-3 font-semibold text-ink hover:bg-paper">
        Gönder
      </button>
      <p class="text-sm text-dim">Spam koruması: gizli tuzak alanı ve Netlify'ın yerleşik spam filtresi.</p>
    </form>
  </section>
  <!-- Netlify formu sadece göreli action ile tanır; S3/EC2 kopyalarında gönderimi Netlify'a yönlendir. -->
  <script define:vars={{ formSite: FORM_SITE_URL }}>
    if (location.origin !== formSite) {
      document.querySelector('form[name="iletisim"]').action = formSite + "/tesekkurler.html";
    }
  </script>
</Base>
