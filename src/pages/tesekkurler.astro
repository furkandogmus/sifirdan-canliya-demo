---
import Base from "../layouts/Base.astro";
---

<Base title="Teşekkürler" description="Mesajın ulaştı.">
  <section class="mx-auto max-w-2xl px-4 py-24 text-center sm:px-6">
    <p class="font-mono text-sm uppercase tracking-[0.2em] text-accent">Gönderildi</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">Teşekkürler!</h1>
    <p class="mt-4 text-lg text-muted">Mesajın ulaştı. Bir e-posta bıraktıysan döneceğiz.</p>
    <a href="/" class="mt-10 inline-block rounded-xl border border-line px-5 py-3 font-semibold hover:border-accent hover:text-accent">
      Ana sayfaya dön
    </a>
  </section>
</Base>
